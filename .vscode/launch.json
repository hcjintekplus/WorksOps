{
    // IntelliSense를 사용하여 가능한 특성에 대해 알아보세요.
    // 기존 특성에 대한 설명을 보려면 가리킵니다.
    // 자세한 내용을 보려면 https://go.microsoft.com/fwlink/?linkid=830387을(를) 방문하세요.
    "version": "0.2.0",
    "configurations": [
        {
            // 포트는 package.json 의 "dev" 스크립트(-p 55240)와 맞춰야 한다.
            // localhost 가 아니라 127.0.0.1 이어야 한다 — dev 는 -H 127.0.0.1 로 IPv4 에만
            // 바인딩하는데 이 PC 의 localhost 는 ::1(IPv6) 로 풀려 연결이 거부된다(-102).
            // 경로 뒤의 /worksops 는 next.config.ts 의 basePath — 빼면 404 가 난다.
            "type": "editor-browser",
            "request": "launch",
            "name": "WorksOps (통합 브라우저)",
            "url": "http://127.0.0.1:55240/worksops",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "next dev"
        },
        {
            // 콘솔·네트워크 탭이 필요할 때. 위와 같은 서버를 Chrome 으로 연다.
            "type": "chrome",
            "request": "launch",
            "name": "WorksOps (Chrome)",
            "url": "http://127.0.0.1:55240/worksops",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "next dev"
        }
    ]
}
